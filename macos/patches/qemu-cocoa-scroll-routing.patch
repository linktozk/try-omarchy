From: Try Omarchy contributors
Subject: [PATCH] ui/cocoa: route precise scrolling to explicit devices

Preserve AppKit's precise deltas and gesture lifecycle, then route them to
explicitly named scroll sinks. Automatic mode sends phase-bearing trackpad
gestures to the virtual touchpad and phase-less input to the high-resolution
wheel, avoiding QEMU's global first-matching input-handler selection.

diff --git a/qapi/ui.json b/qapi/ui.json
index e76aa4c..f58d338 100644
--- a/qapi/ui.json
+++ b/qapi/ui.json
@@ -1452,6 +1452,16 @@
 # @zoom-interpolation: Apply interpolation to smooth output when
 #     zoom-to-fit is enabled.  Defaults to "off".  (Since 9.0)
 #
+# @scroll-touchpad: QOM device ID of a scroll-gesture-sink for precise
+#     trackpad scrolling.
+#
+# @scroll-wheel: QOM device ID of a scroll-gesture-sink for precise
+#     mouse-wheel scrolling.
+#
+# @scroll-mode: Route precise scroll events to "auto", "trackpad", or
+#     "wheel".  In auto mode, phase-bearing gestures use the touchpad;
+#     phase-less events use the high-res wheel.  (default: auto)
+#
 # Since: 7.0
 ##
 { 'struct': 'DisplayCocoa',
@@ -1461,7 +1471,10 @@
       '*immersive': 'bool',
       '*swap-opt-cmd': 'bool',
       '*zoom-to-fit': 'bool',
-      '*zoom-interpolation': 'bool'
+      '*zoom-interpolation': 'bool',
+      '*scroll-touchpad': 'str',
+      '*scroll-wheel': 'str',
+      '*scroll-mode': 'str'
   } }
 
 ##
diff --git a/ui/cocoa.m b/ui/cocoa.m
index dbd90e6..7992a2f 100644
--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -38,6 +38,7 @@
 #include "ui/console.h"
 #include "ui/input.h"
 #include "ui/cocoa-pinch.h"
+#include "ui/scroll-gesture.h"
 #include "ui/kbd-state.h"
 #include "system/system.h"
 #include "system/runstate.h"
@@ -56,6 +57,7 @@
 #include <Carbon/Carbon.h>
 #include <AppKit/NSOpenGL.h>
 #include "hw/core/cpu.h"
+#include "hw/core/qdev.h"
 
 #ifdef CONFIG_EGL
 #include "ui/egl-context.h"
@@ -113,11 +115,79 @@ static void cocoa_switch(DisplayChangeListener *dcl,
 static bool immersive_mode_enabled = true;
 static NSMenuItem *fullScreenMenuItem;
 
+typedef enum CocoaScrollMode {
+    COCOA_SCROLL_MODE_AUTO,
+    COCOA_SCROLL_MODE_TRACKPAD,
+    COCOA_SCROLL_MODE_WHEEL,
+} CocoaScrollMode;
+
+static CocoaScrollMode scroll_mode;
+static ScrollGestureSink *scroll_touchpad_sink;
+static ScrollGestureSink *scroll_wheel_sink;
+
 static bool zoom_interpolation;
 static NSTextField *pauseLabel;
 
 static bool allow_events;
 
+static ScrollGesturePhase cocoa_scroll_phase(NSEventPhase phase)
+{
+    if (phase & NSEventPhaseCancelled) {
+        return SCROLL_GESTURE_PHASE_CANCEL;
+    }
+    if (phase & NSEventPhaseBegan) {
+        return SCROLL_GESTURE_PHASE_BEGIN;
+    }
+    if (phase & NSEventPhaseEnded) {
+        return SCROLL_GESTURE_PHASE_END;
+    }
+    if (phase & (NSEventPhaseChanged | NSEventPhaseStationary |
+                 NSEventPhaseMayBegin)) {
+        return SCROLL_GESTURE_PHASE_UPDATE;
+    }
+    return SCROLL_GESTURE_PHASE_NONE;
+}
+
+static ScrollGestureSink *cocoa_scroll_sink_for_event(NSEvent *event)
+{
+    bool phased;
+
+    if (scroll_mode == COCOA_SCROLL_MODE_TRACKPAD) {
+        return scroll_touchpad_sink;
+    }
+    if (scroll_mode == COCOA_SCROLL_MODE_WHEEL) {
+        return scroll_wheel_sink;
+    }
+
+    phased = [event phase] != NSEventPhaseNone ||
+             [event momentumPhase] != NSEventPhaseNone;
+    return phased ? scroll_touchpad_sink : scroll_wheel_sink;
+}
+
+static ScrollGestureSink *cocoa_scroll_find_sink(const char *id,
+                                                  const char *option)
+{
+    DeviceState *dev;
+    Object *obj;
+
+    if (!id) {
+        return NULL;
+    }
+    dev = qdev_find_recursive(sysbus_get_default(), id);
+    if (!dev) {
+        error_report("Cocoa %s device '%s' was not found", option, id);
+        exit(1);
+    }
+    obj = object_dynamic_cast(OBJECT(dev), TYPE_SCROLL_GESTURE_SINK);
+    if (!obj) {
+        error_report("Cocoa %s device '%s' does not implement %s",
+                     option, id, TYPE_SCROLL_GESTURE_SINK);
+        exit(1);
+    }
+    object_ref(obj);
+    return SCROLL_GESTURE_SINK(obj);
+}
+
 static NSInteger cbchangecount = -1;
 static QemuClipboardInfo *cbinfo;
 static QemuEvent cbevent;
@@ -369,6 +439,12 @@ - (bool) handlePinchLocked:(NSEvent *)event;
 static void cocoa_pinch_vm_change(void *opaque, bool running, RunState state)
 {
     [cocoaView resetPinchLocked:running];
+    if (scroll_touchpad_sink) {
+        scroll_gesture_sink_reset(scroll_touchpad_sink, running);
+    }
+    if (scroll_wheel_sink) {
+        scroll_gesture_sink_reset(scroll_wheel_sink, running);
+    }
 }
 
 
@@ -1183,6 +1259,26 @@ - (bool) handleEventLocked:(NSEvent *)event
              * This is in-line with standard Mac OS X UI behaviour.
              */
 
+            if ([event hasPreciseScrollingDeltas] &&
+                (scroll_touchpad_sink || scroll_wheel_sink)) {
+                ScrollGestureSink *sink = cocoa_scroll_sink_for_event(event);
+                ScrollGestureSample sample = {
+                    .dx = [event scrollingDeltaX],
+                    .dy = [event scrollingDeltaY],
+                    .timestamp_ns = [event timestamp] * NANOSECONDS_PER_SECOND,
+                    .phase = cocoa_scroll_phase([event phase]),
+                    .momentum_phase = cocoa_scroll_phase(
+                        [event momentumPhase]),
+                    .precise = true,
+                };
+
+                if (!sink) {
+                    sink = scroll_touchpad_sink ?: scroll_wheel_sink;
+                }
+                scroll_gesture_sink_send(sink, &sample);
+                return true;
+            }
+
             /* Determine if this is a scroll up or scroll down event */
             if ([event deltaY] != 0) {
                 button = ([event deltaY] > 0) ?
@@ -2718,6 +2814,23 @@ static void cocoa_display_init(DisplayState *ds, DisplayOptions *opts)
     zoom_interpolation = opts->u.cocoa.has_zoom_interpolation &&
                          opts->u.cocoa.zoom_interpolation;
 
+    if (!opts->u.cocoa.scroll_mode ||
+        !strcmp(opts->u.cocoa.scroll_mode, "auto")) {
+        scroll_mode = COCOA_SCROLL_MODE_AUTO;
+    } else if (!strcmp(opts->u.cocoa.scroll_mode, "trackpad")) {
+        scroll_mode = COCOA_SCROLL_MODE_TRACKPAD;
+    } else if (!strcmp(opts->u.cocoa.scroll_mode, "wheel")) {
+        scroll_mode = COCOA_SCROLL_MODE_WHEEL;
+    } else {
+        error_report("invalid Cocoa scroll-mode '%s' (expected auto, "
+                     "trackpad, or wheel)", opts->u.cocoa.scroll_mode);
+        exit(1);
+    }
+    scroll_touchpad_sink = cocoa_scroll_find_sink(
+        opts->u.cocoa.scroll_touchpad, "scroll-touchpad");
+    scroll_wheel_sink = cocoa_scroll_find_sink(
+        opts->u.cocoa.scroll_wheel, "scroll-wheel");
+
     create_initial_menus();
     /*
      * Create the menu entries which depend on QEMU state (for consoles
@@ -2766,6 +2879,10 @@ static void cocoa_display_cleanup(void)
     qemu_event_destroy(&cbevent);
     [cbowner release];
     cbowner = nil;
+    object_unref(OBJECT(scroll_touchpad_sink));
+    object_unref(OBJECT(scroll_wheel_sink));
+    scroll_touchpad_sink = NULL;
+    scroll_wheel_sink = NULL;
 }
 
 static QemuDisplay qemu_display_cocoa = {
